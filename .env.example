# Application.
PROJECT_NAME="Ensights"
ENVIRONMENT=local

# Security.
SECRET_KEY=your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database.
POSTGRESQL_SERVER=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=ensights
POSTGRESQL_PASSWORD=your-postgresql-password
POSTGRESQL_DATABASE=ensights
# Extra databases created on first initialization for companion services.
# The list includes databases for included services and any extra databases
# such as a demo/preview database.
POSTGRESQL_ADDITIONAL_DATABASES=metabase
POSTGRESQL_AUTHENTICATION_METHOD=scram-sha-256
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=your-redis-password
REDIS_CLUSTER=false
REDIS_MAX_CONNECTIONS=50
REDIS_AOF_REWRITE_PERCENTAGE=100
REDIS_AOF_REWRITE_MINIMUM_SIZE=64mb
REDIS_MAXIMUM_MEMORY=256mb
REDIS_MAXIMUM_CLIENTS=10000

# RabbitMQ.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=ensights
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_CONSUMER_TIMEOUT=36000000

# Metabase.
METABASE_PORT=3000
METABASE_DATABASE_TYPE=postgres
METABASE_DATABASE_NAME=metabase
METABASE_DATABASE_PORT=5432
METABASE_DATABASE_USER=ensights
METABASE_DATABASE_PASSWORD=
METABASE_READ_ONLY_PASSWORD=your-metabase-read-only-password

# Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ensights.com
SMTP_USE_TLS=true

# Superuser.
FIRST_SUPERUSER_EMAIL=admin@ensights.com
FIRST_SUPERUSER_PASSWORD=your-superuser-password
FIRST_SUPERUSER_FULL_NAME=Admin

# CORS.
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Rate Limiting.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_MINUTE_API_KEY=300

# Encryption.
CRYPTO_KEY=your-32-bit-fernet-key==

# GlitchTip/Sentry.
# Set to your Sentry/GlitchTip DSN to enable error tracking
SENTRY_DSN=https://public:secret@sentry.com/1

# SSL Certificate Path.
SSL_CERTIFICATE_PATH=

