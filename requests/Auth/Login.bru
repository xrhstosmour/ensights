meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{adminEmail}}
  password: {{adminPassword}}
}

script:post-response {
  bru.setEnvVar("token", res.body.access_token);
}

docs {
  Logs in and stores the access token in the `token` environment variable, so every other request in this collection can reuse it via the collection-level bearer auth.
}
